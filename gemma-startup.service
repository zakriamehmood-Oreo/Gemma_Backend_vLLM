[Unit]
Description=Gemma 4 API Startup
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/bin/bash /data/Gemma_Backend_vLLM/startup.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
