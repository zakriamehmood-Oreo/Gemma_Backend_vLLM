# Model
MODEL_ID=google/gemma-4-E2B-it
HF_TOKEN=                        # required — get from https://huggingface.co/settings/tokens

# Inference backend
# Use "transformers" on Windows/local (no GPU required)
# Use "vllm" on Linux cloud instance with GPU
INFERENCE_BACKEND=transformers

# Generation defaults
MAX_NEW_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
LOAD_IN_4BIT=true

# Server
HOST=0.0.0.0
PORT=8000

# API key — leave empty to disable auth (local dev only)
# In production, set a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Concurrency
MAX_CONCURRENT=10     # max requests processed at the same time
MAX_QUEUE_DEPTH=50    # max requests allowed to wait in queue before 429 is returned
